#include <bits/stdc++.h>
using namespace std;

int variableCount;

#define MAXM 40
#define MAXT 400
#define MAXP 400
#define MAXR 6000

struct Term
{
    char bits[6];
    int cover[MAXM];
    int coverSize;
};

void toBin(int x, char *out)
{
    for (int i = 0; i < variableCount; i++)
        out[i] = '0';

    out[variableCount] = '\0';

    for (int i = variableCount - 1; i >= 0; i--)
    {
        out[i] = '0' + (x % 2);
        x /= 2;
    }
}

bool inCover(Term &t, int m)
{
    for (int i = 0; i < t.coverSize; i++)
    {
        if (t.cover[i] == m)
            return true;
    }

    return false;
}

bool merge(Term &a, Term &b, Term &result)
{
    int diff = 0;
    int pos = -1;

    for (int i = 0; i < variableCount; i++)
    {
        if (a.bits[i] != b.bits[i])
        {
            if (a.bits[i] == '-' || b.bits[i] == '-')
                return false;

            diff++;
            pos = i;
        }
    }

    if (diff != 1)
        return false;

    for (int i = 0; i < variableCount; i++)
        result.bits[i] = a.bits[i];

    result.bits[variableCount] = '\0';
    result.bits[pos] = '-';
    result.coverSize = 0;

    for (int i = 0; i < a.coverSize; i++)
        result.cover[result.coverSize++] = a.cover[i];

    for (int i = 0; i < b.coverSize; i++)
        result.cover[result.coverSize++] = b.cover[i];

    return true;
}

void getPrimes(int minterms[], int mintermCount,
               Term primeImplicantsOut[],
               int &primeImplicantCount)
{
    Term cur[MAXT];
    int curSize = mintermCount;

    for (int i = 0; i < mintermCount; i++)
    {
        toBin(minterms[i], cur[i].bits);

        cur[i].coverSize = 0;
        cur[i].cover[cur[i].coverSize++] = minterms[i];
    }

    Term collected[MAXP];
    int collectedCount = 0;

    while (curSize > 0)
    {
        bool used[MAXT] = {};

        Term next[MAXT];
        int nextSize = 0;

        for (int i = 0; i < curSize; i++)
        {
            for (int j = i + 1; j < curSize; j++)
            {
                Term t;

                if (merge(cur[i], cur[j], t))
                {
                    used[i] = true;
                    used[j] = true;

                    bool dup = false;

                    for (int k = 0; k < nextSize; k++)
                    {
                        if (strcmp(next[k].bits, t.bits) == 0)
                        {
                            for (int m = 0; m < t.coverSize; m++)
                            {
                                if (!inCover(next[k], t.cover[m]))
                                {
                                    next[k].cover[next[k].coverSize++] =
                                        t.cover[m];
                                }
                            }

                            dup = true;
                            break;
                        }
                    }

                    if (!dup)
                        next[nextSize++] = t;
                }
            }
        }

        for (int i = 0; i < curSize; i++)
        {
            if (!used[i])
                collected[collectedCount++] = cur[i];
        }

        curSize = nextSize;

        for (int i = 0; i < nextSize; i++)
            cur[i] = next[i];
    }

    primeImplicantCount = 0;

    for (int i = 0; i < collectedCount; i++)
    {
        bool dup = false;

        for (int j = 0; j < primeImplicantCount; j++)
        {
            if (strcmp(primeImplicantsOut[j].bits,
                       collected[i].bits) == 0)
            {
                dup = true;
                break;
            }
        }

        if (!dup)
            primeImplicantsOut[primeImplicantCount++] = collected[i];
    }
}

string toExpr(char *bits)
{
    string vars = "abcde";
    string s = "";

    for (int i = 0; i < variableCount; i++)
    {
        if (bits[i] == '1')
        {
            s += vars[i];
        }
        else if (bits[i] == '0')
        {
            s += vars[i];
            s += '\'';
        }
    }

    if (s.empty())
        s = "1";

    return s;
}

Term candidateTerms[MAXP];
int candidateCount;
int candidateTermsIndex[MAXP];

int results[MAXR][MAXM];
int resultSizes[MAXR];
int solutionCount;

int chosenArr[MAXM];
int chosenSize;

void search(int remainingMinterms[], int remainingCount)
{
    if (remainingCount == 0)
    {
        for (int i = 0; i < chosenSize; i++)
            results[solutionCount][i] = chosenArr[i];

        resultSizes[solutionCount] = chosenSize;
        solutionCount++;

        return;
    }

    int m = remainingMinterms[0];

    for (int i = 0; i < candidateCount; i++)
    {
        if (!inCover(candidateTerms[i], m))
            continue;

        int newRemain[MAXM];
        int newRemainSize = 0;

        for (int j = 0; j < remainingCount; j++)
        {
            if (!inCover(candidateTerms[i],
                         remainingMinterms[j]))
            {
                newRemain[newRemainSize++] =
                    remainingMinterms[j];
            }
        }

        chosenArr[chosenSize++] = i;

        search(newRemain, newRemainSize);

        chosenSize--;
    }
}

int main()
{
    cout << "Enter number of variables (2 to 5): ";
    cin >> variableCount;

    int colVars, rowVars;

    if (variableCount == 2)
    {
        colVars = 1;
        rowVars = 1;
    }
    else if (variableCount == 3)
    {
        colVars = 2;
        rowVars = 1;
    }
    else if (variableCount == 4)
    {
        colVars = 2;
        rowVars = 2;
    }
    else
    {
        colVars = 3;
        rowVars = 2;
    }

    int cols = 1;

    for (int i = 0; i < colVars; i++)
        cols *= 2;

    int rows = 1;

    for (int i = 0; i < rowVars; i++)
        rows *= 2;

    int gray1[2] = {0, 1};
    int gray2[4] = {0, 1, 3, 2};
    int gray3[8] = {0, 1, 3, 2, 6, 7, 5, 4};

    int *colOrder;
    int *rowOrder;

    if (colVars == 1)
        colOrder = gray1;
    else if (colVars == 2)
        colOrder = gray2;
    else
        colOrder = gray3;

    if (rowVars == 1)
        rowOrder = gray1;
    else if (rowVars == 2)
        rowOrder = gray2;
    else
        rowOrder = gray3;

    int minterms[MAXM];
    int mintermCount = 0;

    cout << "Enter the k-map ("
         << rows << " rows x "
         << cols << " cols, values 0 or 1):"
         << endl;

    for (int r = 0; r < rows; r++)
    {
        for (int c = 0; c < cols; c++)
        {
            int value;
            cin >> value;

            if (value == 1)
            {
                minterms[mintermCount++] =
                    colOrder[c] * rows + rowOrder[r];
            }
        }
    }

    Term primeImplicants[MAXP];
    int primeImplicantCount;

    getPrimes(minterms,
              mintermCount,
              primeImplicants,
              primeImplicantCount);

    int coverCount[MAXM];
    int coveringPrime[MAXM];

    for (int i = 0; i < mintermCount; i++)
    {
        coverCount[i] = 0;
        coveringPrime[i] = -1;

        for (int j = 0; j < primeImplicantCount; j++)
        {
            if (inCover(primeImplicants[j], minterms[i]))
            {
                coverCount[i]++;
                coveringPrime[i] = j;
            }
        }
    }

    int essentialTerms[MAXP];
    int essentialTermsCount = 0;

    for (int i = 0; i < mintermCount; i++)
    {
        if (coverCount[i] == 1)
        {
            int p = coveringPrime[i];
            bool already = false;

            for (int j = 0; j < essentialTermsCount; j++)
            {
                if (essentialTerms[j] == p)
                    already = true;
            }

            if (!already)
                essentialTerms[essentialTermsCount++] = p;
        }
    }

    int remainingMinterms[MAXM];
    int remainingCount = 0;

    for (int i = 0; i < mintermCount; i++)
    {
        bool done = false;

        for (int j = 0; j < essentialTermsCount; j++)
        {
            if (inCover(primeImplicants[essentialTerms[j]],
                        minterms[i]))
            {
                done = true;
                break;
            }
        }

        if (!done)
            remainingMinterms[remainingCount++] = minterms[i];
    }

    candidateCount = 0;

    for (int i = 0; i < primeImplicantCount; i++)
    {
        bool essential = false;

        for (int j = 0; j < essentialTermsCount; j++)
        {
            if (essentialTerms[j] == i)
                essential = true;
        }

        if (!essential)
        {
            candidateTerms[candidateCount] =
                primeImplicants[i];

            candidateTermsIndex[candidateCount] = i;
            candidateCount++;
        }
    }

    solutionCount = 0;
    chosenSize = 0;

    if (remainingCount > 0)
    {
        search(remainingMinterms, remainingCount);
    }
    else
    {
        resultSizes[solutionCount] = 0;
        solutionCount++;
    }

    int minSize = 1000;

    for (int i = 0; i < solutionCount; i++)
    {
        if (resultSizes[i] < minSize)
            minSize = resultSizes[i];
    }

    string expressions[MAXR];
    int expressionCount = 0;

    for (int i = 0; i < solutionCount; i++)
    {
        if (resultSizes[i] != minSize)
            continue;

        int all[MAXP];
        int allSize = 0;

        for (int j = 0; j < essentialTermsCount; j++)
            all[allSize++] = essentialTerms[j];

        for (int j = 0; j < resultSizes[i]; j++)
        {
            int p = candidateTermsIndex[results[i][j]];
            bool already = false;

            for (int k = 0; k < allSize; k++)
            {
                if (all[k] == p)
                    already = true;
            }

            if (!already)
                all[allSize++] = p;
        }

        string terms[MAXP];
        int termsSize = 0;

        for (int j = 0; j < allSize; j++)
        {
            terms[termsSize++] =
                toExpr(primeImplicants[all[j]].bits);
        }

        sort(terms, terms + termsSize);

        string expr = "";

        for (int j = 0; j < termsSize; j++)
        {
            if (j > 0)
                expr += " + ";

            expr += terms[j];
        }

        bool already = false;

        for (int j = 0; j < expressionCount; j++)
        {
            if (expressions[j] == expr)
                already = true;
        }

        if (!already)
            expressions[expressionCount++] = expr;
    }

    for (int i = 0; i < expressionCount; i++)
        cout << expressions[i] << endl;

    return 0;
}
