#include <iostream>
#include <string>
#include <algorithm>
using namespace std;

struct Group
{
    int a[16];
    int n;
    string term;
    int lit;
};

string getTerm(int a[], int n)
{
    string s = "";

    for (int b = 3; b >= 0; b--)
    {
        int x = (a[0] >> b) & 1;
        bool ok = true;

        for (int i = 1; i < n; i++)
        {
            if (((a[i] >> b) & 1) != x)
            {
                ok = false;
                break;
            }
        }

        if (ok)
        {
            s += char('A' + 3 - b);

            if (x == 0)
                s += "'";
        }
    }

    if (s.empty())
        s = "1";

    return s;
}

bool equalGroup(int a[], int b[], int n)
{
    for (int i = 0; i < n; i++)
    {
        if (a[i] != b[i])
            return false;
    }

    return true;
}

bool checkGroup(int mp[4][4], int a[], int n)
{
    int g[4] = {0, 1, 3, 2};

    for (int i = 0; i < n; i++)
    {
        int m = a[i];
        int rr = m / 4;
        int cc = m % 4;

        int r = 0, c = 0;

        for (int j = 0; j < 4; j++)
        {
            if (g[j] == rr)
                r = j;

            if (g[j] == cc)
                c = j;
        }

        if (mp[r][c] == 0)
            return false;
    }

    return true;
}

int makeGroups(int mp[4][4], Group gr[])
{
    int g[4] = {0, 1, 3, 2};
    int sz[3] = {1, 2, 4};
    int total = 0;

    for (int x = 0; x < 3; x++)
    {
        for (int y = 0; y < 3; y++)
        {
            int nr = sz[x];
            int nc = sz[y];

            for (int sr = 0; sr < 4; sr++)
            {
                for (int sc = 0; sc < 4; sc++)
                {
                    int temp[16];
                    int cnt = 0;

                    for (int r = 0; r < nr; r++)
                    {
                        for (int c = 0; c < nc; c++)
                        {
                            int r1 = (sr + r) % 4;
                            int c1 = (sc + c) % 4;

                            temp[cnt++] = g[r1] * 4 + g[c1];
                        }
                    }

                    sort(temp, temp + cnt);

                    if (!checkGroup(mp, temp, cnt))
                        continue;

                    bool found = false;

                    for (int i = 0; i < total; i++)
                    {
                        if (gr[i].n == cnt &&
                            equalGroup(gr[i].a, temp, cnt))
                        {
                            found = true;
                            break;
                        }
                    }

                    if (found)
                        continue;

                    for (int i = 0; i < cnt; i++)
                        gr[total].a[i] = temp[i];

                    gr[total].n = cnt;
                    gr[total].term = getTerm(temp, cnt);
                    gr[total].lit = 0;

                    for (char ch : gr[total].term)
                    {
                        if (ch >= 'A' && ch <= 'D')
                            gr[total].lit++;
                    }

                    total++;
                }
            }
        }
    }

    return total;
}

bool allCovered(Group gr[], int chosen[], int cnt,
                int minterms[], int mcnt)
{
    for (int i = 0; i < mcnt; i++)
    {
        bool yes = false;

        for (int j = 0; j < cnt; j++)
        {
            int x = chosen[j];

            for (int k = 0; k < gr[x].n; k++)
            {
                if (gr[x].a[k] == minterms[i])
                {
                    yes = true;
                    break;
                }
            }

            if (yes)
                break;
        }

        if (!yes)
            return false;
    }

    return true;
}

void solve(Group gr[], int gn, int minterms[], int mn,
           int chosen[], int cnt, int start,
           int &bestCnt, int &bestLit,
           int answer[], int &answerCnt)
{
    if (allCovered(gr, chosen, cnt, minterms, mn))
    {
        int lits = 0;

        for (int i = 0; i < cnt; i++)
            lits += gr[chosen[i]].lit;

        if (cnt < bestCnt ||
            (cnt == bestCnt && lits < bestLit))
        {
            bestCnt = cnt;
            bestLit = lits;
            answerCnt = cnt;

            for (int i = 0; i < cnt; i++)
                answer[i] = chosen[i];
        }

        return;
    }

    if (cnt >= bestCnt)
        return;

    for (int i = start; i < gn; i++)
    {
        chosen[cnt] = i;

        solve(gr, gn, minterms, mn,
              chosen, cnt + 1, i + 1,
              bestCnt, bestLit, answer, answerCnt);
    }
}

int main()
{
    int mp[4][4];
    int gray[4] = {0, 1, 3, 2};

    int minterms[16];
    int mcnt = 0;

    cout << "Enter 4 x 4 K-map values:\n";

    for (int i = 0; i < 4; i++)
    {
        for (int j = 0; j < 4; j++)
            cin >> mp[i][j];
    }

    for (int i = 0; i < 4; i++)
    {
        for (int j = 0; j < 4; j++)
        {
            if (mp[i][j] == 1)
            {
                minterms[mcnt] = gray[i] * 4 + gray[j];
                mcnt++;
            }
        }
    }

    cout << "\nMinterms: ";

    for (int i = 0; i < mcnt; i++)
        cout << minterms[i] << " ";

    cout << "\n";

    if (mcnt == 0)
    {
        cout << "Minimum Boolean Expression: 0\n";
        return 0;
    }

    Group gr[100];

    int gn = makeGroups(mp, gr);

    cout << "\nPossible Groups:\n";

    for (int i = 0; i < gn; i++)
    {
        cout << i + 1 << ". ( ";

        for (int j = 0; j < gr[i].n; j++)
            cout << gr[i].a[j] << " ";

        cout << ") ---> " << gr[i].term << "\n";
    }

    int chosen[100];
    int answer[100];

    int bestCnt = 1000;
    int bestLit = 1000;
    int answerCnt = 0;

    solve(gr, gn, minterms, mcnt,
          chosen, 0, 0,
          bestCnt, bestLit,
          answer, answerCnt);

    cout << "\nMINIMUM BOOLEAN EXPRESSION\n\n";

    for (int i = 0; i < answerCnt; i++)
    {
        if (i != 0)
            cout << " + ";

        cout << gr[answer[i]].term;
    }

    cout << "\n\nMinimum number of groups: "
         << bestCnt;

    cout << "\nMinimum number of literals: "
         << bestLit << "\n";

    return 0;
}
